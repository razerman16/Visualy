{
  "name": "visualy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @visualy/shared && npm run build -w @visualy/api && npm run build -w @visualy/admin && npm run build -w @visualy/player",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @visualy/api",
    "dev:admin": "npm run dev -w @visualy/admin",
    "dev:player": "npm run dev -w @visualy/player",
    "test:smoke": "node tests/smoke.mjs",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:deployment": "node tests/deployment-config.mjs && node --test tests/legacy/deployment-scripts.test.mjs",
    "test:branding": "node tests/branding.mjs",
    "test:player-build": "node tests/player-build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3"
  }
}
