# Run sh scripts/init-env.sh to generate missing secrets; do not use empty values.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SETUP_TOKEN=
CONVERTER_TOKEN=
# Published Caddy ports (both interfaces share these ports).
BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Localhost HTTP only, when compose.dev.yaml is explicitly used.
DEV_ADMIN_PORT=8080
DEV_PLAYER_PORT=8081
# Hostnames only: no scheme, path or port.
ADMIN_DOMAIN=admin.visualy.home.arpa
PLAYER_DOMAIN=player.visualy.home.arpa
MEDIA_QUOTA_MB=10240
# Change all three together if this subnet overlaps your LAN/VPN.
FRONTEND_SUBNET=172.30.240.0/24
FRONTEND_DYNAMIC_RANGE=172.30.240.128/25
CADDY_IP=172.30.240.2

# Optional HTTPS localhost mode (Docker Compose >= 2.24.4).
# Uncomment BOTH lines to enable; no DNS or hosts-file entry is needed.
# COMPOSE_PATH_SEPARATOR=|
# COMPOSE_FILE=compose.yaml|compose.localhost.yaml
# Admin: https://localhost (CADDY_HTTPS_PORT); player: https://localhost:8443
LOCAL_PLAYER_HTTPS_PORT=8443

# Direct access through the existing server IPv4 address:
# run sh scripts/init-env.sh --ip ON THE DOCKER HOST to detect it and select the mode.
# SERVER_IP is a certificate address, not a network/IP assignment.
# SERVER_IP=192.168.1.50
CADDY_PLAYER_HTTPS_PORT=8443
