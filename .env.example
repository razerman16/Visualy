# Pour generer un mot de passe local aleatoire : sh scripts/init-env.sh
# Utiliser uniquement des caracteres hexadecimaux pour cette valeur incorporee dans l'URL PostgreSQL.
POSTGRES_PASSWORD=
BIND_ADDRESS=0.0.0.0
ADMIN_PORT=8080
PLAYER_PORT=8081
# Passer a true pour le deploiement HTTPS local documente.
COOKIE_SECURE=false
