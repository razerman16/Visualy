# Run sh scripts/init-env.sh to generate missing secrets.
# Keep existing secrets when upgrading an initialized database.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SETUP_TOKEN=
CONVERTER_TOKEN=

# Default: direct HTTP on the server IP, without Caddy, DNS or certificates.
BIND_ADDRESS=0.0.0.0
ADMIN_PORT=8080
PLAYER_PORT=8081
MEDIA_QUOTA_MB=10240

# Optional HTTPS: see docs/https.md. The initialization script selects the mode.
# sh scripts/init-env.sh --https     (DNS names)
# sh scripts/init-env.sh --ip        (existing server IP)
# sh scripts/init-env.sh --localhost (same machine only)
# sh scripts/init-env.sh --http      (return to direct HTTP)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_PLAYER_HTTPS_PORT=8443
LOCAL_PLAYER_HTTPS_PORT=8443
ADMIN_DOMAIN=admin.visualy.home.arpa
PLAYER_DOMAIN=player.visualy.home.arpa
# SERVER_IP=192.168.1.50

# Internal Docker network, not the server's LAN IP.
# Change these together if the subnet overlaps your LAN/VPN.
FRONTEND_SUBNET=172.30.240.0/24
FRONTEND_DYNAMIC_RANGE=172.30.240.128/25
CADDY_IP=172.30.240.2

# Localhost-only development override.
DEV_ADMIN_PORT=8080
DEV_PLAYER_PORT=8081

# Existing scenzly installations: run scripts/migrate-visualy.sh BEFORE startup.
# It writes COMPOSE_PROJECT_NAME=visualy and VOLUME_PREFIX=scenzly to reuse data.
# New installations automatically use visualy and their own volume names.
