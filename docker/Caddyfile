{
    local_certs
    admin off
}
{$ADMIN_DOMAIN} {
    tls internal
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy admin-web:80 {
        header_up X-Real-IP {remote_host}
    }
}
{$PLAYER_DOMAIN} {
    tls internal
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy player-web:80 {
        header_up X-Real-IP {remote_host}
    }
}
